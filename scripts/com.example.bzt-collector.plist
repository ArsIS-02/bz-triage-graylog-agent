<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.bzt-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/bzt-stream.sh</string>
    </array>

    <!-- Раз в час. Отредактируйте под свой интервал. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/bzt-collector.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/bzt-collector.err</string>

    <!-- Работаем от root: bz_triage требует прав на системные пути. -->
    <key>UserName</key>
    <string>root</string>
</dict>
</plist>
